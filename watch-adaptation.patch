+  testWidgets('watch narrow screen warns above 2.0x speed', (tester) async {
+    final session = _Session();
+    await _mount(tester, session);
+    // setSurfaceSize 在这个 Flutter 版本里不改 tester.view，显式设成
+    // 320×700 逻辑(dp) < compactShellDockBreakpoint(340) 才会走手表分支。
+    tester.view
+      ..devicePixelRatio = 1.0
+      ..physicalSize = const Size(320, 700);
+    addTearDown(tester.view.reset);
+    await tester.pump();
+    await tester.ensureVisible(find.byKey(const ValueKey('audio-speed')));
+    await tester.tap(find.byKey(const ValueKey('audio-speed')));
+    await tester.pumpAndSettle();
+    expect(find.text('超过 2.0× 在手表上可能卡顿'), findsNothing);
+
+    final slider = tester.widget<Slider>(
+      find.byKey(const ValueKey('audio-speed-slider')),
+    );
+    slider.onChanged!(2.5);
+    await _flush(tester);
+    await tester.pumpAndSettle();
+    expect(find.text('超过 2.0× 在手表上可能卡顿'), findsOneWidget);
+
+    tester
+        .widget<Slider>(find.byKey(const ValueKey('audio-speed-slider')))
+        .onChanged!(2.0);
+    await _flush(tester);
+    await tester.pumpAndSettle();
+    expect(find.text('超过 2.0× 在手表上可能卡顿'), findsNothing);
+
+    // 关掉面板时按最终值轻提醒一次（会话内只弹一次）。
+    tester
+        .widget<Slider>(find.byKey(const ValueKey('audio-speed-slider')))
+        .onChanged!(2.5);
+    await _flush(tester);
+    await tester.pumpAndSettle();
+    // 这个假 app 没有 BackButton，直接 pop 掉 bottom sheet 这条 route。
+    Navigator.of(
+      tester.element(find.byKey(const ValueKey('audio-speed-slider'))),
+    ).pop();
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 100));
+    expect(
+      find.text('高倍速在手表上可能卡顿，建议不超过 2.0×'),
+      findsOneWidget,
+    );
+  });
